{
  "name": "va-kontrollzentrum",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Kontrollzentrum für Virtuelle Assistenz - acht Agenten besetzen die Positionen des Unternehmens: Konzept, Einrichtung, Betrieb",
  "scripts": {
    "dev": "concurrently -n \"WEB,API\" -c \"cyan,magenta\" \"vite\" \"node --watch server/index.js\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7",
    "wrangler": "^4.127.1"
  }
}
