# Kopie dieser Datei als ".env" anlegen und ausfüllen.
# Die .env wird von Git ignoriert und darf niemals ins Repo.

# Schlüssel für die Anthropic-API. Wird nur vom Server benutzt, nie vom Browser.
# Zu finden unter console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Welches Modell die acht Fachleute benutzen.
# claude-opus-5   - beste Qualität, teurer  (Standard)
# claude-sonnet-5 - schneller und günstiger
MODELL=claude-opus-5

# Port des lokalen API-Servers (muss zum Proxy in vite.config.js passen)
PORT=8787
